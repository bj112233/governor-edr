# Sentinel Agent — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored — never commit real keys.

# ── Telegram (required for alert delivery) ──
TELEGRAM_BOT_TOKEN=        # Get from @BotFather on Telegram
TELEGRAM_CHAT_ID=          # Get from @userinfobot on Telegram

# ── Threat Intel APIs (all optional — features degrade gracefully without them) ──
VIRUSTOTAL_API_KEY=        # https://www.virustotal.com/gui/join-us
ABUSEIPDB_API_KEY=         # https://www.abuseipdb.com/account
URLHAUS_AUTH_KEY=          # https://urlhaus.abuse.ch/
THREATFOX_AUTH_KEY=        # https://threatfox.abuse.ch/
NVD_API_KEY=               # https://nvd.nist.gov/developers/request-an-api-key (optional, raises rate limit)

# ── AI Search (optional — last-resort OSINT tier) ──
AI_SEARCH_API_KEY=         # OpenRouter API key for AI_SEARCH fallback

# ── Web Dashboard (optional — LAN dashboard) ──
WEB_C2_AUTH_USER=admin
WEB_C2_AUTH_PASSWORD=      # Set a strong password if enabling the dashboard

# ── LLM (defaults work with KoboldCpp on localhost) ──
LLM_API_BASE=http://127.0.0.1:5001/v1
LLM_MODEL=qwen3.5-4b
LLM_API_KEY=lm-studio
